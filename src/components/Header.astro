---
import Menu from '../assets/icons/menu.svg';
---

<header class="border-b border-slate-700 bg-slate-900/95 p-4 text-slate-100 shadow-lg backdrop-blur-sm transition-colors duration-300">
  <div class="container mx-auto flex items-center justify-between pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button
          id="menu-toggle"
          type="button"
          data-testid="header-menu-toggle"
          class="mr-4 rounded-md border border-slate-700 bg-slate-800 p-2 text-slate-100 transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="menu"
        >
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav
          id="menu"
          aria-label="Main"
          data-testid="header-menu"
          class="absolute left-0 z-10 mt-2 hidden w-48 rounded-lg border border-slate-700 bg-slate-800 text-slate-100 shadow-xl"
        >
          <ul class="py-1">
            <li><a href="/" data-testid="header-home-link" class="block px-4 py-2 text-sm transition hover:bg-slate-700 hover:text-white">Home</a></li>
            <li><a href="/about" data-testid="header-about-link" class="block px-4 py-2 text-sm transition hover:bg-slate-700 hover:text-white">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold">
        <a href="/" data-testid="header-brand-link" class="text-slate-100 hover:text-blue-400 hover:underline">Tailspin Toys</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }
</script>